# ---- Pinecone (vector DB) ----
# Free tier: https://app.pinecone.io  (Starter plan, no card needed for serverless free tier)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=agentic-ai-ebook
# Pinecone serverless region/cloud for index creation
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---- Embeddings ----
# Served via Pinecone's hosted Inference API (no separate key needed, uses PINECONE_API_KEY).
# Free, multilingual-e5-large, 1024 dims.
EMBEDDING_MODEL=multilingual-e5-large

# ---- LLM (Groq, free tier) ----
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# llama-3.1-8b-instant is Enterprise-only as of late 2026 and will 404 on
# free-tier keys. Use one of these instead (all on the free/developer tier):
#   llama-3.3-70b-versatile   (default -- good quality, still fast)
#   openai/gpt-oss-20b         (smaller/cheaper, also solid)
# Run `python scripts/list_groq_models.py` to see exactly what your key can use.
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Source document ----
SOURCE_PDF_URL=https://konverge.ai/pdf/Ebook-Agentic-AI.pdf

# ---- Retrieval / guardrail tuning ----
TOP_K=5
RELEVANCE_SCORE_THRESHOLD=0.72
MAX_QUERY_CHARS=800

# ---- App ----
LOG_LEVEL=INFO
